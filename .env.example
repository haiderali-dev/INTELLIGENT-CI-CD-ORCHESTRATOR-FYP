# Copy to .env and fill in real values. .env is gitignored and must never be committed.
# Every value below is a placeholder. Nothing here is a real credential.

# --- LLM provider (Groq, OpenAI-compatible endpoint) ---
GROQ_API_KEY=gsk_replace_me
LLM_MODEL_CHAIN=openai/gpt-oss-120b,openai/gpt-oss-20b
# live = call Groq · replay = serve recorded fixtures · fake = deterministic answers
LLM_MODE=fake

# --- Jenkins ---
JENKINS_URL=http://jenkins-dev:8080
JENKINS_ADMIN_PASSWORD=replace_me_admin
# The least-privilege bot. scripts/bootstrap.py creates its API token and writes JENKINS_TOKEN.
JENKINS_USER=orchestrator-bot
JENKINS_BOT_PASSWORD=replace_me_bot
JENKINS_TOKEN=

# --- Database ---
POSTGRES_DB=orchestrator
POSTGRES_USER=orchestrator
POSTGRES_PASSWORD=replace_me_postgres
DATABASE_URL=postgresql+asyncpg://orchestrator:replace_me_postgres@postgres:5432/orchestrator

# --- Backend security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_me_with_48_random_bytes
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Shared bearer token the plugin uses to post metrics to POST /api/metrics.
METRICS_TOKEN=replace_me_metrics_token

# --- Seed admin, created once by the seed script ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_me_admin_password

# --- Application ---
CATALOG_PATH=catalog/services.yaml
FRONTEND_ORIGIN=http://localhost:5173
HIGH_URGENCY_DAILY_QUOTA=3
