<!--
  Exported from jenkins-dev with GET /job/reference-freestyle-downstream/config.xml.

  This is what Jenkins itself produced, not hand-written XML. BUILD_PROMPT rule 1.4:
  every config.xml template is derived from a job created on jenkins-dev and exported,
  never written from memory. Phase 5's Jinja2 templates are built from these files, and
  the golden-file tests compare rendered output against them.

  Regenerate with: python scripts/export_reference_configs.py
-->
<?xml version="1.1" encoding="UTF-8"?>
<project>
