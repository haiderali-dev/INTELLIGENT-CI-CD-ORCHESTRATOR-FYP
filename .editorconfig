root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{java,groovy}]
indent_size = 4

[Jenkinsfile]
indent_size = 4

[*.py]
indent_size = 4

[*.{js,jsx,ts,tsx,json,css,scss,html,jelly}]
indent_size = 2

[*.{yaml,yml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{ps1,bat,cmd}]
end_of_line = crlf

[Makefile]
indent_style = tab
